{
  "name": "scs",
  "displayName": "scs",
  "description": "shortcut",
  "version": "0.0.5",
  "license": "MIT",
  "engines": {
    "vscode": "^1.58.0"
  },
  "publisher": "mmsan",
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "activationEvents": [
    "onLanguage:scs",
    "onCommand:extension.beautifyScs"
  ],
  "main": "./extension",
  "repository": {},
  "contributes": {
    "commands": [
      {
        "command": "extension.beautifyScs",
        "title": "Beautify SQL"
      }
    ],
    "keybindings": [
      {
        "command": "extension.beautifyScs",
        "key": "alt+shift+f",
        "when": "editorTextFocus && !editorReadonly && editorLangId =~ /scs/ "
      }
    ],
    "languages": [
      {
        "id": "scs",
        "aliases": [
          "shortcut",
          "scs"
        ],
        "extensions": [
          "scs"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "scs",
        "scopeName": "shortcut",
        "path": "./syntaxes/scs.tmLanguage.json"
      }
    ]
  },
  "dependencies": {
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "vscode": "^0.11.0"
  }
}
