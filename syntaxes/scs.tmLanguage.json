{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "shortcut",
  "patterns": [
    {
      "include": "#keywords"
    },
    {
      "include": "#comment"
    },
    {
      "include": "#strings"
    }
  ],
  "repository": {
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.scs",
          "match": "\\/\\/\\/.*"
        },
        {
          "name": "keyword.control.scs",
          "match": "\\(\\d+\\)"
        },
        {
          "name": "keyword.control.scs",
          "match": "((?<=\\{)[\\d&|!()]*\\?(?=(.+?}|\\s*\\n))|<>|\\{\/?d2?\\})"
        }
        
      ]
    },
    "comment": {
      "begin": "// ",
      "end": "\\n",
      "name": "comment.line.double-slash"
    },  
    "strings": {
      "name": "string.quoted.double.scs",
      "begin": "(\"|`|')",
      "end": "\\1",
      "patterns": [
        {
          "name": "keyword.control.scs",
          "match": "((?<=\\{)[\\d&|!()]*\\?(?=(.+?}|\\s*\\n))|<>|\\{\/?d2?\\})"
        }
      ]   
    }
  },
  "scopeName": "shortcut"
}