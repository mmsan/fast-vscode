{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "shortcut",
  "patterns": [
    {
      "include": "#keywords"
    },
    {
			"include": "#statements"
		},
    {
      "include": "#comment"
    },
    {
      "include": "#label"
    },
    {
      "include": "#strings"
    }
  ],
  "repository": {
    "label": {
      "patterns":
       [
        {
          "name": "label.control.scs",
          "match": "^\\s*\\/\\/\\/.*"
        }
      ]
    },
    "keywords": {
      "patterns":
       [
        {
          "name": "keyword.control.scs",
          "match": "\\(\\d+\\)"
        },
        {
          "name": "keyword.control.scs",
          "match": "^\\s*=\\s*.*"
        },
        {
          "name": "keyword.control.scs",
          "match": "((?<=\\{)([\\d&|!()]*\\?|!)(?=(.+?}|\\s*\\n))|<>|\\{\/?d2?\\})"
        }
      ]
    },
    "comment": {
      "begin": "^\\s*//(?=( |\\n))",
      "end": "\\n",
      "name": "comment.line.double-slash"
    },  


    "strings": {
      "name": "string.quoted.double.scs",
      "begin": "(\"|`|')",
      "end": "\\1",
      "patterns": [
        {
          "name": "keyword.control.scs",
          "match": "((?<=\\{)([\\d&|!()]*\\?|!)(?=(.+?}|\\s*\\n))|<>|\\{\/?d2?\\})"
        }
      ]   
    }
  },
  "scopeName": "shortcut"
}
